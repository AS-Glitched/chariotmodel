# ---------------------------------------------------------------- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# ------------------------------------------------- CHARIOT runtime (heavy) ---
# The runtime tree is regenerated by scripts/prepare_dataset.py and
# scripts/run_chariot3.py.  It holds the SQLite lineage store, sealed
# capsules, River Flow slices and the materialised Parquet datasets — none of
# which belong in git.
chariot-vscode/var/
chariot-vscode/data/

# Materialised datasets, sealed extracts, capsule payloads.
*.parquet
*.sqlite
*.db
*.db-wal
*.db-shm
*.db-journal
chariot-vscode/var/**
chariot-vscode/runs/**/sealed_extract.parquet

# Full advisory payload dumps (multi-MB, regenerable in ~1 min).  The small
# manifests/metrics (manifest.json, summary.json, windows.json) are committed.
chariot-vscode/runs/**/advisories.json

# Raw telemetry exports (16 MB+).  Ingest via scripts/prepare_dataset.py.
chariot-vscode/data/**/*.csv
chariot-vscode/runs/**/*.csv
*.csv.gz

# ------------------------------------------------------------ smoke runs ---
chariot-vscode/runs/_smoke*/
chariot-vscode/runs/_tmp*/

# ------------------------------------------------------------------ misc ----
.DS_Store
Thumbs.db
*.log
